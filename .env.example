# Copy to .env before running locally. `.env*` is gitignored.

# ---------------------------------------------------------------------------
# Local development — Postgres in Docker on port 5433
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://isupply:isupply@localhost:5433/isupply

# Admin area password (/en/admin). Set a real value before deploying anywhere
# reachable — see "Before this is production" in the README.
ADMIN_PASSWORD=changeme

# Display-only FX rate. Prices are stored in USD cents and converted at render
# time for the fa locale. Not a live rate — update by hand.
USD_TO_TOMAN=110000


# ---------------------------------------------------------------------------
# Deployed environments
# ---------------------------------------------------------------------------
# Use the POOLED connection string, not the direct one. On Neon that is the
# host containing "-pooler"; on Supabase it is the pgBouncer port (6543).
# A direct connection will exhaust the database's connection limit once more
# than a couple of function instances are warm.
#
#   DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
#
# Schema push and seeding run from your machine against the remote database.
# Put the pooled URL in .env.production.local (gitignored) and run:
#
#   npm run db:setup:remote
#
# The seeder makes a few hundred round trips, so over a WAN expect a couple of
# minutes rather than the ~14 seconds it takes locally.
