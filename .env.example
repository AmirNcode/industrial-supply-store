# Copy to .env before running locally. `.env*` is gitignored.

# ---------------------------------------------------------------------------
# Local development — Postgres in Docker on port 5433
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://isupply:isupply@localhost:5433/isupply

# Full-Docker builds run in a build container, where localhost is not the host.
# BuildKit mounts this as a secret only for `next build`; it is not an image ARG.
DOCKER_BUILD_DATABASE_URL=postgres://isupply:isupply@host.docker.internal:5433/isupply

# ---------------------------------------------------------------------------
# Catalog image and CSV-import storage — hosted or self-hosted Supabase Storage
# ---------------------------------------------------------------------------
# Server-reachable Supabase API gateway. For a single-host development setup
# this is usually the same URL a browser uses. In Docker it may instead be an
# internal service name such as http://supabase-api-gw:8000.
SUPABASE_URL=

# Optional browser-facing base URL. Set this when SUPABASE_URL uses an internal
# Docker hostname; stored image URLs will use this public reverse-proxy origin.
SUPABASE_PUBLIC_URL=

# Browser-safe key used only with a short-lived signed upload URL for large CSV
# imports. Prefer the newer publishable key; the legacy anon key also works.
# Neither is a secret. Do not put the secret/service-role key in either field.
# Keep these server-runtime names: the import route returns the selected public
# key on demand. NEXT_PUBLIC_ copies are build-time values and can silently keep
# an old Supabase project after an environment change.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Server secret only — never use a NEXT_PUBLIC_ name. Hosted Supabase supports
# SUPABASE_SECRET_KEY; self-hosted stacks commonly provide the legacy
# SUPABASE_SERVICE_ROLE_KEY. The app accepts either one.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Created as a public JPG/PNG/WebP bucket on the first upload. Change only if
# this name is shared with another application.
SUPABASE_CATALOG_BUCKET=catalog-images

# Created as a private text/csv bucket on the first import. It must be distinct
# from the public image bucket. The browser uploads directly to this bucket via
# a signed URL, keeping the 24 MB CSV out of the app request-body path.
SUPABASE_IMPORT_BUCKET=catalog-imports

# Admin area password (/en/admin). Required in production: the app refuses to
# serve /admin if this is unset or still `changeme`, because that page holds
# every customer's name, email, phone and address, issues invoices, resets
# customer passwords, exports the full price list and can overwrite the catalog.
ADMIN_PASSWORD=changeme

# Display-only FX rate. Prices are stored in USD cents and converted at render
# time for the fa locale. Not a live rate — update by hand.
USD_TO_TOMAN=110000


# ---------------------------------------------------------------------------
# Deployed environments
# ---------------------------------------------------------------------------
# Use the POOLED connection string, not the direct one. On Neon that is the
# host containing "-pooler"; on Supabase it is the pgBouncer port (6543).
# A direct connection will exhaust the database's connection limit once more
# than a couple of function instances are warm.
#
#   DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
#
# Forward migrations run from your machine against the remote database. Put the
# URLs in .env.production.local (gitignored), dry-run first, verify a restorable
# backup/PITR recovery point, then provide today's UTC date for the write gate:
#
#   npm run db:migrate:check:remote
#   MIGRATION_BACKUP_VERIFIED=YYYY-MM-DD npm run db:migrate:remote
#   npm run db:verify:remote
#
# A brand-new database has a separate bootstrap command. It requires
# EMPTY_DATABASE_CONFIRMED=1 and refuses to run if `public` already has a table;
# it is never the upgrade path for a live database.
#
# Schema pushes and bulk seeding are unreliable through a TRANSACTION pooler
# (no prepared statements), so point those at a session-mode connection instead.
#
# On Supabase, all three strings live behind the "Connect" button at the top of
# the project dashboard, NOT under Project Settings:
#
#   Direct connection    db.<ref>.supabase.co:5432             IPv6 ONLY
#   Session pooler       aws-<region>.pooler.supabase.com:5432  IPv4 ✓
#   Transaction pooler   aws-<region>.pooler.supabase.com:6543  IPv4 ✓
#
# Use the SESSION POOLER for DIRECT_DATABASE_URL, not the direct connection.
# Supabase direct connections are IPv6-only without the paid IPv4 add-on, and
# most home networks — and Vercel itself — are IPv4-only. Session mode behaves
# like a direct connection and supports prepared statements, so drizzle-kit and
# the seeder work against it.
#
#   DATABASE_URL=<transaction pooler, :6543>   # the app
#   DIRECT_DATABASE_URL=<session pooler, :5432> # drizzle-kit push and the seeder
#
# db:reset and db:seed refuse to run against a non-local host unless their
# explicit destructive override is set. Normal remote releases never set one;
# only the zero-public-table bootstrap invokes the seeder after proving emptiness.

# ---------------------------------------------------------------------------
# Invoice "from" block
# ---------------------------------------------------------------------------
# ADDRESS is pipe-separated, one line per segment.
# Append _FA to any of these to give a Persian variant, e.g. SELLER_NAME_FA.
SELLER_NAME=TEMEX Co.
SELLER_ADDRESS=Unit 4, Sanat Street|Tehran 1234567|Iran
SELLER_EMAIL=sales@temex.example
SELLER_PHONE=+98 21 8888 0000
SELLER_TAX_ID=

# ---------------------------------------------------------------------------
# Demo deployment only
# ---------------------------------------------------------------------------
# DEMO_MODE=1 makes /admin publicly readable with no password, shows a site-wide
# "sample data" banner, and warns on the quote form that submissions are public.
#
# Leave this UNSET for a self-hosted production deployment. With it on, every
# submitted company name, contact, email, phone and address is world-readable.
#
# DEMO_MODE=1

# Signs the customer session cookie. Required in production — the app refuses
# to start without it, because a predictable key lets anyone mint a session for
# any account. Generate with: openssl rand -base64 32
#
# This is resolved when the module is first imported, which means `next build`
# needs it too, not just the running server: a deploy without it fails during
# "Collecting page data" rather than in front of a customer. On Netlify and
# Vercel a normal environment variable already covers both. Docker Compose
# mounts the same value as a BuildKit secret and a runtime secret file.
AUTH_SECRET=
