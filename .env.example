# Copy to .env before running. `.env` is gitignored.

# Local dev: app runs on the host, Postgres runs in Docker on port 5433.
DATABASE_URL=postgres://isupply:isupply@localhost:5433/isupply

# Admin area password (/en/admin). Set a real value before showing this
# to anyone — see the "Before this is production" section of the README.
ADMIN_PASSWORD=changeme

# Display-only FX rate. Prices are stored in USD cents and converted at render
# time for the fa locale. Not a live rate — update by hand.
USD_TO_TOMAN=110000
