{
  "name": "industrial-supply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test src/lib/*.test.ts",
    "test:db": "npm run test:db:orders && npm run test:db:integrity && npm run test:db:rate-limits",
    "test:db:orders": "dotenv -e .env -- node --import tsx --conditions=react-server --test src/db/orderIntegrity.integration.test.ts",
    "test:db:integrity": "dotenv -e .env -- node --import tsx --conditions=react-server --test src/db/dataIntegrity.integration.test.ts",
    "test:db:rate-limits": "dotenv -e .env -- node --import tsx --conditions=react-server --test src/db/rateLimit.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:push": "tsx scripts/push-local-schema.mts",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:migrate:check": "tsx scripts/migrate.mts --dry-run",
    "db:bootstrap:local": "tsx src/seed/reset.ts && npm run db:push && npm run db:migrate && tsx src/seed/index.ts",
    "db:extensions": "tsx scripts/apply-extensions.mts",
    "db:verify": "tsx scripts/verify-remote.mts",
    "db:reconcile:check": "tsx scripts/reconcile-data.mts",
    "db:reconcile:apply": "tsx scripts/reconcile-data.mts --apply",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "npm run db:bootstrap:local",
    "db:rename-orders": "tsx scripts/rename-quotes-to-orders.mts",
    "db:column-tiers": "tsx scripts/add-column-tiers.mts",
    "db:catalog-media": "tsx scripts/add-catalog-media.mts",
    "i18n:missing": "tsx scripts/find-untranslated.mjs",
    "db:rename-orders:remote": "dotenv -e .env.production.local -v ALLOW_REMOTE_MIGRATION=1 -- tsx scripts/rename-quotes-to-orders.mts",
    "db:migrate:remote": "dotenv -e .env.production.local -- tsx scripts/migrate.mts",
    "db:migrate:check:remote": "dotenv -e .env.production.local -- tsx scripts/migrate.mts --dry-run",
    "db:bootstrap:empty:remote": "dotenv -e .env.production.local -- tsx scripts/bootstrap-empty-database.mts",
    "db:extensions:remote": "dotenv -e .env.production.local -- tsx scripts/apply-extensions.mts",
    "db:reconcile:check:remote": "dotenv -e .env.production.local -- tsx scripts/reconcile-data.mts",
    "db:reconcile:apply:remote": "dotenv -e .env.production.local -- tsx scripts/reconcile-data.mts --apply",
    "db:verify:remote": "dotenv -e .env.production.local -- tsx scripts/verify-remote.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vercel/config": "^0.5.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "supabase": "2.114.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
