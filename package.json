{
  "name": "industrial-supply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "tsx src/seed/reset.ts && drizzle-kit push && tsx src/seed/index.ts",
    "i18n:missing": "tsx scripts/find-untranslated.mjs",
    "db:push:remote": "dotenv -e .env.production.local -- drizzle-kit push",
    "db:seed:remote": "dotenv -e .env.production.local -v ALLOW_REMOTE_SEED=1 -- tsx src/seed/index.ts",
    "db:setup:remote": "npm run db:push:remote && npm run db:seed:remote",
    "db:verify:remote": "dotenv -e .env.production.local -- tsx scripts/verify-remote.mts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.6",
    "next": "^16.2.9",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/config": "^0.5.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
